<?xml version="1.0"?>
<!--
Simple Bipedal Robot for Balance Control Testing
- 3 DOF per leg (hip pitch, knee, ankle pitch)
- Large feet for stability
- Low center of mass
- Realistic mass distribution
-->
<robot name="simple_biped">

  <!-- Base/Torso Link -->
  <link name="torso">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.02"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.30 0.20"/>
      </geometry>
      <material name="torso_color">
        <color rgba="0.8 0.8 0.8 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.30 0.20"/>
      </geometry>
    </collision>
  </link>

  <!-- ========== LEFT LEG ========== -->

  <!-- Left Hip Joint (pitch only for simplicity) -->
  <joint name="left_hip_pitch" type="revolute">
    <origin xyz="0 0.10 -0.10" rpy="0 0 0"/>
    <parent link="torso"/>
    <child link="left_thigh"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="300.0" velocity="10.0"/>
    <dynamics damping="1.0" friction="0.5"/>
  </joint>

  <link name="left_thigh">
    <inertial>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.10 0.30"/>
      </geometry>
      <material name="thigh_color">
        <color rgba="0.6 0.6 0.9 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.10 0.30"/>
      </geometry>
    </collision>
  </link>

  <!-- Left Knee Joint -->
  <joint name="left_knee" type="revolute">
    <origin xyz="0 0 -0.30" rpy="0 0 0"/>
    <parent link="left_thigh"/>
    <child link="left_shin"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.5" effort="300.0" velocity="10.0"/>
    <dynamics damping="1.0" friction="0.5"/>
  </joint>

  <link name="left_shin">
    <inertial>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.010" ixy="0" ixz="0" iyy="0.010" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.30"/>
      </geometry>
      <material name="shin_color">
        <color rgba="0.5 0.5 0.8 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.30"/>
      </geometry>
    </collision>
  </link>

  <!-- Left Ankle Joint -->
  <joint name="left_ankle_pitch" type="revolute">
    <origin xyz="0 0 -0.30" rpy="0 0 0"/>
    <parent link="left_shin"/>
    <child link="left_foot"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.8" upper="0.8" effort="300.0" velocity="10.0"/>
    <dynamics damping="0.5" friction="0.3"/>
  </joint>

  <link name="left_foot">
    <inertial>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.004"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.12 0.04"/>
      </geometry>
      <material name="foot_color">
        <color rgba="0.3 0.3 0.3 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.12 0.04"/>
      </geometry>
    </collision>
  </link>

  <!-- ========== RIGHT LEG ========== -->

  <!-- Right Hip Joint (pitch only) -->
  <joint name="right_hip_pitch" type="revolute">
    <origin xyz="0 -0.10 -0.10" rpy="0 0 0"/>
    <parent link="torso"/>
    <child link="right_thigh"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="300.0" velocity="10.0"/>
    <dynamics damping="1.0" friction="0.5"/>
  </joint>

  <link name="right_thigh">
    <inertial>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.10 0.30"/>
      </geometry>
      <material name="thigh_color">
        <color rgba="0.6 0.6 0.9 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.10 0.30"/>
      </geometry>
    </collision>
  </link>

  <!-- Right Knee Joint -->
  <joint name="right_knee" type="revolute">
    <origin xyz="0 0 -0.30" rpy="0 0 0"/>
    <parent link="right_thigh"/>
    <child link="right_shin"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.5" effort="300.0" velocity="10.0"/>
    <dynamics damping="1.0" friction="0.5"/>
  </joint>

  <link name="right_shin">
    <inertial>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.010" ixy="0" ixz="0" iyy="0.010" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.30"/>
      </geometry>
      <material name="shin_color">
        <color rgba="0.5 0.5 0.8 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.30"/>
      </geometry>
    </collision>
  </link>

  <!-- Right Ankle Joint -->
  <joint name="right_ankle_pitch" type="revolute">
    <origin xyz="0 0 -0.30" rpy="0 0 0"/>
    <parent link="right_shin"/>
    <child link="right_foot"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.8" upper="0.8" effort="300.0" velocity="10.0"/>
    <dynamics damping="0.5" friction="0.3"/>
  </joint>

  <link name="right_foot">
    <inertial>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.004"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.12 0.04"/>
      </geometry>
      <material name="foot_color">
        <color rgba="0.3 0.3 0.3 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.12 0.04"/>
      </geometry>
    </collision>
  </link>

</robot>
